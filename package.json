{
  "name": "meu-espaco",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env.local --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin:password": "node --env-file-if-exists=.env.local scripts/reset-password.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env.local scripts/restore.mjs",
    "test:docker": "node tests/docker-smoke.mjs",
    "format": "prettier --write src server scripts tests package.json tsconfig.json vite.config.ts index.html compose.yaml README.md",
    "format:check": "prettier --check src server scripts tests package.json tsconfig.json vite.config.ts index.html compose.yaml README.md"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-mathematics": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@xyflow/react": "^12.0.0",
    "fastify": "^5.0.0",
    "katex": "^0.18.10",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "prettier": "^3.6.2"
  }
}
